# Recherche par IA (optionnelle) — fonction serverless /api/ai-search
#
# Clé OpenAI, UNIQUEMENT côté serveur (jamais exposée au navigateur).
# À définir dans Vercel : Project → Settings → Environment Variables.
# Sans cette clé, l'app fonctionne normalement ; la recherche IA affiche
# simplement un message « non configuré ».
OPENAI_API_KEY=

# Mettre "false" pour masquer complètement l'UI de recherche IA.
# Exposée au navigateur (préfixe VITE_), ne JAMAIS y mettre de secret.
VITE_AI_ENABLED=
